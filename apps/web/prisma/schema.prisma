generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  SECURITY_ANALYST
  AUDITOR
  MEMBER
}

enum IdentityType {
  HUMAN
  SERVICE
  WORKLOAD
  AI_AGENT
}

enum LifecycleEventType {
  JOINER
  MOVER
  LEAVER
}

enum LifecycleRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum IdentityStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  PENDING
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AccessGrantStatus {
  ACTIVE
  REVOKED
}

enum CertificationCampaignStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CertificationItemStatus {
  PENDING
  CERTIFIED
  REVOKED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  identities  Identity[]
  auditEvents    AuditEvent[]
  applications   Application[]
  entitlements   Entitlement[]
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]
  certificationCampaigns CertificationCampaign[]
  policyRules PolicyRule[]
  identityRiskSnapshots IdentityRiskSnapshot[]
  identityRiskAlerts IdentityRiskAlert[]
  lifecycleRequests LifecycleRequest[]

  @@index([createdAt])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  emailVerified DateTime?
  name         String?
  image        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  auditEvents  AuditEvent[] @relation("AuditActor")
  accounts     Account[]
  sessions     Session[]
  requestedAccess AccessRequest[] @relation("AccessRequester")
  decidedAccess   AccessRequest[] @relation("AccessDecider")
  grantedAccess   AccessGrant[]   @relation("GrantActor")
  createdCertifications CertificationCampaign[] @relation("CertificationCreator")
  reviewedCertifications CertificationItem[] @relation("CertificationReviewer")
  changedPolicyVersions PolicyRuleVersion[] @relation("PolicyVersionActor")
  requestedLifecycleRequests LifecycleRequest[] @relation("LifecycleRequester")
  decidedLifecycleRequests LifecycleRequest[] @relation("LifecycleDecider")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Identity {
  id             String         @id @default(cuid())
  organizationId String
  externalId     String?
  displayName    String
  email          String?
  type           IdentityType
  status         IdentityStatus @default(PENDING)
  source          String?
  lastSeenAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]
  riskSnapshots IdentityRiskSnapshot[]
  riskAlerts IdentityRiskAlert[]
  lifecycleRequests LifecycleRequest[]

  @@unique([organizationId, externalId])
  @@index([organizationId, type, status])
  @@index([organizationId, email])
}

model Application {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?      @db.Text
  ownerTeam      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entitlements   Entitlement[]

  @@unique([organizationId, slug])
  @@index([organizationId, name])
}

model Entitlement {
  id             String       @id @default(cuid())
  organizationId String
  applicationId  String
  key            String
  name           String
  description    String?      @db.Text
  riskLevel      String       @default("MEDIUM")
  privileged     Boolean      @default(false)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]

  @@unique([applicationId, key])
  @@index([organizationId, enabled, riskLevel])
  @@index([organizationId, applicationId])
}

model AccessRequest {
  id               String              @id @default(cuid())
  organizationId   String
  identityId       String
  entitlementId    String
  requesterUserId  String
  decisionUserId   String?
  status           AccessRequestStatus @default(PENDING)
  requestReason    String              @db.Text
  decisionReason   String?             @db.Text
  decidedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity         Identity            @relation(fields: [identityId], references: [id], onDelete: Cascade)
  entitlement      Entitlement         @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  requester        User                @relation("AccessRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  decisionUser     User?               @relation("AccessDecider", fields: [decisionUserId], references: [id], onDelete: SetNull)
  grant            AccessGrant?

  @@index([organizationId, status, createdAt])
  @@index([identityId, entitlementId, status])
  @@index([requesterUserId, createdAt])
}

model AccessGrant {
  id             String           @id @default(cuid())
  organizationId String
  identityId     String
  entitlementId  String
  requestId      String?          @unique
  grantedById    String?
  status         AccessGrantStatus @default(ACTIVE)
  grantedAt      DateTime         @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       Identity         @relation(fields: [identityId], references: [id], onDelete: Cascade)
  entitlement    Entitlement      @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  request        AccessRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  grantedBy      User?            @relation("GrantActor", fields: [grantedById], references: [id], onDelete: SetNull)
  certificationItems CertificationItem[]

  @@index([organizationId, status, grantedAt])
  @@index([identityId, entitlementId, status])
}

model CertificationCampaign {
  id             String                      @id @default(cuid())
  organizationId String
  name           String
  description    String?                     @db.Text
  status         CertificationCampaignStatus @default(IN_PROGRESS)
  dueAt          DateTime
  createdById    String
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                        @relation("CertificationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items          CertificationItem[]

  @@index([organizationId, status, dueAt])
  @@index([createdById, createdAt])
}

model CertificationItem {
  id             String                  @id @default(cuid())
  campaignId     String
  grantId        String
  status         CertificationItemStatus @default(PENDING)
  reviewerId     String?
  decisionReason String?                 @db.Text
  decidedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  campaign       CertificationCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  grant          AccessGrant              @relation(fields: [grantId], references: [id], onDelete: Restrict)
  reviewer       User?                    @relation("CertificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([campaignId, grantId])
  @@index([campaignId, status])
  @@index([grantId, status])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  outcome        AuditOutcome
  reason         String?
  correlationId  String?
  metadata       Json?
  occurredAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, targetType, targetId])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
}


model PolicyRule {
  id               String   @id @default(cuid())
  organizationId   String
  key              String
  name             String
  description      String?  @db.Text
  effect           String
  field            String
  operator         String
  value            String
  priority         Int      @default(100)
  enabled          Boolean  @default(false)
  version          Int      @default(1)
  lastSimulatedAt  DateTime?
  validatedVersion Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions         PolicyRuleVersion[]

  @@unique([organizationId, key])
  @@index([organizationId, enabled, priority])
}

model PolicyRuleVersion {
  id             String   @id @default(cuid())
  policyRuleId   String
  version        Int
  snapshot       Json
  changeNote     String?
  changedById    String
  createdAt      DateTime @default(now())
  policyRule     PolicyRule @relation(fields: [policyRuleId], references: [id], onDelete: Cascade)
  changedBy      User @relation("PolicyVersionActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([policyRuleId, version])
  @@index([policyRuleId, createdAt])
}

model IdentityRiskSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  identityId     String
  score          Int
  level          String
  factors        Json
  methodology    String
  capturedOn     DateTime     @db.Date
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, identityId, capturedOn])
  @@index([organizationId, capturedOn])
  @@index([identityId, capturedOn])
}

model IdentityRiskAlert {
  id String @id @default(cuid())
  organizationId String
  identityId String
  alertType String
  previousScore Int
  currentScore Int
  scoreDelta Int
  capturedOn DateTime @db.Date
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  @@unique([organizationId, identityId, alertType, capturedOn])
  @@index([organizationId, createdAt])
  @@index([identityId, createdAt])
}

model LifecycleRequest {
  id             String                @id @default(cuid())
  organizationId String
  identityId     String
  requesterUserId String
  decisionUserId String?
  type           LifecycleEventType
  status         LifecycleRequestStatus @default(PENDING)
  reason         String                @db.Text
  grantIds       Json?
  decidedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       Identity               @relation(fields: [identityId], references: [id], onDelete: Cascade)
  requester      User                   @relation("LifecycleRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  decisionUser   User?                  @relation("LifecycleDecider", fields: [decisionUserId], references: [id], onDelete: SetNull)
  @@index([organizationId, status, createdAt])
  @@index([identityId, status])
}
