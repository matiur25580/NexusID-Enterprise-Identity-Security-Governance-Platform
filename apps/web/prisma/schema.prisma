generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  SECURITY_ANALYST
  AUDITOR
  MEMBER
}

enum IdentityType {
  HUMAN
  SERVICE
  WORKLOAD
  AI_AGENT
}

enum IdentityStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  PENDING
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AccessGrantStatus {
  ACTIVE
  REVOKED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  identities  Identity[]
  auditEvents    AuditEvent[]
  applications   Application[]
  entitlements   Entitlement[]
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]

  @@index([createdAt])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  emailVerified DateTime?
  name         String?
  image        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  auditEvents  AuditEvent[] @relation("AuditActor")
  accounts     Account[]
  sessions     Session[]
  requestedAccess AccessRequest[] @relation("AccessRequester")
  decidedAccess   AccessRequest[] @relation("AccessDecider")
  grantedAccess   AccessGrant[]   @relation("GrantActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Identity {
  id             String         @id @default(cuid())
  organizationId String
  externalId     String?
  displayName    String
  email          String?
  type           IdentityType
  status         IdentityStatus @default(PENDING)
  source          String?
  lastSeenAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]

  @@unique([organizationId, externalId])
  @@index([organizationId, type, status])
  @@index([organizationId, email])
}

model Application {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?      @db.Text
  ownerTeam      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entitlements   Entitlement[]

  @@unique([organizationId, slug])
  @@index([organizationId, name])
}

model Entitlement {
  id             String       @id @default(cuid())
  organizationId String
  applicationId  String
  key            String
  name           String
  description    String?      @db.Text
  riskLevel      String       @default("MEDIUM")
  privileged     Boolean      @default(false)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]

  @@unique([applicationId, key])
  @@index([organizationId, enabled, riskLevel])
  @@index([organizationId, applicationId])
}

model AccessRequest {
  id               String              @id @default(cuid())
  organizationId   String
  identityId       String
  entitlementId    String
  requesterUserId  String
  decisionUserId   String?
  status           AccessRequestStatus @default(PENDING)
  requestReason    String              @db.Text
  decisionReason   String?             @db.Text
  decidedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity         Identity            @relation(fields: [identityId], references: [id], onDelete: Cascade)
  entitlement      Entitlement         @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  requester        User                @relation("AccessRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  decisionUser     User?               @relation("AccessDecider", fields: [decisionUserId], references: [id], onDelete: SetNull)
  grant            AccessGrant?

  @@index([organizationId, status, createdAt])
  @@index([identityId, entitlementId, status])
  @@index([requesterUserId, createdAt])
}

model AccessGrant {
  id             String           @id @default(cuid())
  organizationId String
  identityId     String
  entitlementId  String
  requestId      String?          @unique
  grantedById    String?
  status         AccessGrantStatus @default(ACTIVE)
  grantedAt      DateTime         @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       Identity         @relation(fields: [identityId], references: [id], onDelete: Cascade)
  entitlement    Entitlement      @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  request        AccessRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  grantedBy      User?            @relation("GrantActor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, grantedAt])
  @@index([identityId, entitlementId, status])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  outcome        AuditOutcome
  reason         String?
  correlationId  String?
  metadata       Json?
  occurredAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, targetType, targetId])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
}
