{
  "name": "nexusid",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nexusid/web dev",
    "build": "pnpm --filter @nexusid/web build",
    "start": "pnpm --filter @nexusid/web start",
    "lint": "pnpm --filter @nexusid/web lint",
    "typecheck": "pnpm --filter @nexusid/web typecheck",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.0"
  }
}
