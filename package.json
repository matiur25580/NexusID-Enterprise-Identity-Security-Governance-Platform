{
  "name": "nexusid",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nexusid/web dev",
    "build": "pnpm --filter @nexusid/web build",
    "start": "pnpm --filter @nexusid/web start",
    "lint": "pnpm --filter @nexusid/web lint",
    "typecheck": "pnpm --filter @nexusid/web typecheck",
    "test:policy": "node --test tests/policy-regression.test.mjs",
    "test:integration": "pnpm --filter @nexusid/web test:integration",
    "db:generate": "pnpm --filter @nexusid/web exec prisma generate --schema prisma/schema.prisma",
    "db:validate": "pnpm --filter @nexusid/web exec prisma validate --schema prisma/schema.prisma",
    "db:push": "pnpm --filter @nexusid/web exec prisma db push --schema prisma/schema.prisma",
    "db:migrate": "pnpm --filter @nexusid/web exec prisma migrate dev --schema prisma/schema.prisma",
    "test:risk-alerts": "node --test tests/risk-alerts.test.mjs",
    "test:lifecycle": "node --test tests/lifecycle-regression.test.mjs",
    "test:scim": "node --test tests/scim-core.test.mjs"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {}
}
