generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  SECURITY_ANALYST
  AUDITOR
  MEMBER
}

enum IdentityType {
  HUMAN
  SERVICE
  WORKLOAD
  AI_AGENT
}

enum IdentityStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  PENDING
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  identities  Identity[]
  auditEvents AuditEvent[]

  @@index([createdAt])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  image        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  auditEvents  AuditEvent[] @relation("AuditActor")
  accounts     Account[]
  sessions     Session[]
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Identity {
  id             String         @id @default(cuid())
  organizationId String
  externalId     String?
  displayName    String
  email          String?
  type           IdentityType
  status         IdentityStatus @default(PENDING)
  source          String?
  lastSeenAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, type, status])
  @@index([organizationId, email])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  outcome        AuditOutcome
  reason         String?
  correlationId  String?
  metadata       Json?
  occurredAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, targetType, targetId])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
}
