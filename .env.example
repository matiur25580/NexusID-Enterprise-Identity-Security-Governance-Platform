# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://nexusid:nexusid@localhost:5432/nexusid?schema=public"

# Authentication (configure before enabling sign-in)
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL=http://localhost:3000

# Redis (reserved for lifecycle and connector workers)
REDIS_URL=redis://localhost:6379

# OAuth providers (configure at least one)
# Google callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
